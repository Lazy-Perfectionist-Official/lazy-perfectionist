{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --exec \"npx tsx server.ts\" --watch server.ts --watch src --ext ts,tsx,js,jsx 2>&1 | tee dev.log",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "analyze": "node scripts/analyze-bundle.js",
    "optimize-images": "node optimize-images.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/e2e/visual",
    "test:a11y": "playwright test tests/e2e/a11y",
    "test:lighthouse": "playwright test tests/e2e/lighthouse",
    "test:ux": "playwright test tests/e2e/ux",
    "test:judge": "tsx scripts/judge-ui.ts",
    "test:functional": "playwright test tests/e2e/functional --project=chromium-desktop",
    "test:functional:cross-browser": "playwright test tests/e2e/functional --project=chromium-desktop --project=firefox-desktop --project=webkit-desktop",
    "test:cross-browser": "playwright test --project=chromium-desktop --project=firefox-desktop --project=webkit-desktop",
    "test:mobile": "playwright test --project=mobile-chrome-small --project=mobile-safari",
    "lighthouse": "lhci autorun",
    "lighthouse:collect": "lhci collect",
    "lighthouse:assert": "lhci assert",
    "test:pipeline": "npm run test:functional:cross-browser && playwright test tests/e2e/navigation.spec.ts --project=chromium-desktop && npm run test:visual",
    "test:all": "npm run test:e2e && npm run lighthouse:assert"
  },
